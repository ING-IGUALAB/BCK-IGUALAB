# Variables del ejecutor (solo NOMBRES: no escriba aquí valores reales ni suba un archivo con ellos).
# Obligatorias
IGUALAB_PRUEBAS_ENTORNO=qa            # local | qa | uat (uat: ver README, solo manual)
IGUALAB_API_URL=                      # p. ej. http://igualab-backend-qa-backend-1:8000 (sin barra final)
IGUALAB_E2E_SUPERADMIN_CORREO=        # correo del SuperAdmin del entorno
IGUALAB_E2E_SUPERADMIN_PASSWORD=      # contraseña VIGENTE de ese SuperAdmin (Jenkins: credencial IGUALAB_QA_SUPERADMIN)
# Opcionales
IGUALAB_ESPERA_SEGUNDOS=240           # plazo máximo para que /health responda (1-1800)
IGUALAB_CONFIRMO_ESCRITURA_UAT=       # solo para la demostración MANUAL en UAT: SI
