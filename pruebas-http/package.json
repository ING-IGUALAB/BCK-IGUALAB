{
  "name": "igualab-pruebas-http",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas de integración y E2E por HTTP del backend de Igualab (colecciones Postman ejecutadas con Newman).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "dependencies": {
    "newman": "6.2.1"
  },
  "scripts": {
    "generar": "node colecciones/fuentes/generar.mjs",
    "verificar-colecciones": "node colecciones/fuentes/generar.mjs --verificar",
    "integracion": "node scripts/ejecutar.mjs --coleccion integracion",
    "e2e": "node scripts/ejecutar.mjs --coleccion e2e"
  },
  "type": "module"
}
