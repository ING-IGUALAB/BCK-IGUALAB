
# Ambiente de la aplicacion: EXACTAMENTE development | qa | uat. De aqui se deriva el prefijo/ambiente de la ingesta
# (originales en MinIO, duplicados y consultas); no se configura aparte.
APP_ENV=development

BACKEND_URL=https://backend.example.com
FRONTEND_URL=https://frontend.example.com
FRONTEND_RESET_URL=https://frontend.example.com/restablecer
CORS_ORIGINS=https://frontend.example.com

# SQLAlchemy asíncrono requiere postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/base_relacional
# Base VECTORIAL (PostgreSQL + pgvector). Obligatoria SOLO para la funcionalidad vectorial; sin fallback a DATABASE_URL.
VECTOR_DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/base_vectorial

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

#fijos
JWT_ALGORITHM=HS256

SESSION_INACTIVITY_HOURS=2
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

MAIL_USERNAME=tu-correo-de-igualab@gmail.com
MAIL_PASSWORD=contraseña-de-aplicacion-de-16-caracteres

SUPERADMIN_NOMBRE=nombre-del-superadmin
SUPERADMIN_CORREO=correo-del-superadmin
SUPERADMIN_PASSWORD=contraseña-del-superadmin

# --- OCI Generative AI (Embeddings) ---
# Modelo vigente: cohere.embed-v4.0 (1536 dims) · region us-chicago-1.
# La identidad se resuelve por OCI_CONFIG_FILE + OCI_CONFIG_PROFILE
# (archivo ~/.oci/config) o por estas variables (útil en contenedores).
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..<tu-compartment>
OCI_EMBED_MODEL=cohere.embed-v4.0
OCI_EMBED_DIMENSIONS=1536
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=svc-embeddings
OCI_USER_OCID=ocid1.user.oc1..<tu-user>
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
OCI_TENANCY_OCID=ocid1.tenancy.oc1..<tu-tenancy>
# Contenido del archivo .pem (llave privada) en base64, una sola linea.
# Regenerar con:  base64 -w 0 mi-llave.pem
OCI_KEY_PEM_B64=<base64-de-la-llave-privada>

# --- LLM de Chat (DeepSeek) ---
DEEPSEEK_API_KEY=<tu-api-key-de-deepseek>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- Almacenamiento de originales de ingesta (MinIO, API S3) ---
# TODOS los valores de esta sección son FICTICIOS. Las credenciales reales se
# suministran fuera del repositorio (variables del entorno de despliegue).
# Solo se admite HTTPS con certificado verificado.
MINIO_ENDPOINT_URL=https://minio.ejemplo.invalid
MINIO_BUCKET=bucket-ficticio
# Región sin confirmar: déjela vacía hasta conocerla.
MINIO_REGION=
MINIO_ACCESS_KEY=clave-de-acceso-ficticia
MINIO_SECRET_KEY=clave-secreta-ficticia
# El ambiente (prefijo de los originales) se deriva de APP_ENV.

# --- Parametros fijos de la ingesta: viven en CODIGO, no en el entorno ---
# Lote de embeddings 16, plazo por llamada 120 s, vigencia renovable 15 min, recuperacion cada 60 s, espera de cierre 30 s,
# plazos OCI 10/60 s y MinIO 10/60/300 s: ver app/services/ingesta/parametros.py. Se cambian con un commit, sin tocar
# los secretos de Jenkins. Las variables INGESTA_*, MINIO_PREFIX y *_TIMEOUT_SECONDS YA NO SE LEEN: retirelas del .env.
